<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vip.openpark</groupId>
    <artifactId>dubbo-learn</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>dubbo-all-facade</module>
        <module>dubbo-quick-start</module>
        <module>dubbo-integration-registration-center</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 版本管理 -->
        <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
        <spring-boot.version>3.3.2</spring-boot.version>

        <!-- https://mvnrepository.com/artifact/org.apache.dubbo/dubbo -->
        <dubbo.version>3.2.14</dubbo.version>
        <!-- https://mvnrepository.com/artifact/org.apache.curator/curator-x-discovery -->
        <curator-x-discovery.version>5.7.0</curator-x-discovery.version>
        <!-- https://mvnrepository.com/artifact/org.apache.zookeeper/zookeeper -->
        <zookeeper.version>3.9.2</zookeeper.version>
        <!-- https://mvnrepository.com/artifact/org.springframework/spring-context -->
        <spring-context.version>6.1.11</spring-context.version>

        <!-- https://mvnrepository.com/artifact/org.apache.dubbo/dubbo-spring-boot-starter -->
        <dubbo-spring-boot-starter.version>3.2.14</dubbo-spring-boot-starter.version>
        <!-- https://mvnrepository.com/artifact/org.apache.dubbo/dubbo-dependencies-zookeeper-curator5 -->
        <dubbo-dependencies-zookeeper-curator5.version>3.2.14</dubbo-dependencies-zookeeper-curator5.version>
        <!-- https://mvnrepository.com/artifact/org.apache.dubbo/dubbo-registry-nacos -->
        <dubbo-registry-nacos.version>3.2.14</dubbo-registry-nacos.version>
    </properties>

    <dependencies>
        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
        </dependency>
    </dependencies>
</project>